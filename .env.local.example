# Copy to .env.local and fill in.
# AI (caption assistant, video ideas): Gemini, free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Or use Claude instead (used only when GEMINI_API_KEY is empty)
ANTHROPIC_API_KEY=
# Optional: where the SQLite database lives (default: web/data/app.db)
# DB_PATH=

# Meta (Facebook + Instagram). App settings -> Basic. Lets Socialdesk turn short-lived tokens into ones that do not expire.
META_APP_ID=
META_APP_SECRET=

# YouTube (Google Cloud OAuth client, type Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# LinkedIn app (Sign In with LinkedIn using OpenID Connect + Share on LinkedIn)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# X app (OAuth 2.0, Web App, Read and write)
X_CLIENT_ID=
X_CLIENT_SECRET=
# Public base URL used in OAuth redirect URIs (default: the URL you open the app at)
# APP_URL=http://localhost:3210
# Optional: Facebook Login for Business configuration id (use instead of the scope list if Meta asks for one)
# META_CONFIG_ID=
